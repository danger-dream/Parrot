  "affinity": {
    "ttlMinutes": 30,
    "cleanupIntervalSeconds": 300,
    "clientTtlMinutes": 120
  },
  "scoring": {
    "emaAlpha": 0.25,
    "recentWindow": 50,
    "defaultScore": 3000,
    "errorPenaltyFactor": 8,
